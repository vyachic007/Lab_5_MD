<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/settingsContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <TextView
            android:id="@+id/settingsTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:fitsSystemWindows="true" />

        <TextView
            android:id="@+id/fontSizeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/font_size_default"
            android:textSize="16sp"
            android:fitsSystemWindows="true" />

        <SeekBar
            android:id="@+id/fontSizeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:fitsSystemWindows="true" />

        <TextView
            android:id="@+id/itemHeightTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/item_height_auto"
            android:textSize="16sp"
            android:paddingTop="12dp"
            android:fitsSystemWindows="true" />

        <SeekBar
            android:id="@+id/itemHeightSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="120"
            android:fitsSystemWindows="true" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/showManufacturerSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/show_manufacturer"
            android:checked="true"
            android:paddingTop="12dp"
            android:fitsSystemWindows="true" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/showCountrySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/show_country"
            android:checked="true"
            android:fitsSystemWindows="true" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/showQuantitySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/show_quantity"
            android:checked="true"
            android:fitsSystemWindows="true" />

        <CheckBox
            android:id="@+id/largePriceCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/large_price"
            android:fitsSystemWindows="true" />

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:layout_marginTop="20dp"
            android:fitsSystemWindows="true" />

        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/back"
            android:fitsSystemWindows="true" />

    </LinearLayout>

</ScrollView>